# Auralake runs as a single pip-installed binary — no database, no Docker.
# Everything here is optional; copy to .env only if you need to override a default.
#
#   pip install auralake
#   auralake sample            # download the FOCUS sample + seed it (no config)
#   auralake dashboard serve   # http://127.0.0.1:8501

# ── Source credentials (referenced by connections.yml *_env fields) ──
# Only needed once you enable the matching connector in connections.yml.
DATABRICKS_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Platform settings (AURALAKE_*, all optional — defaults shown) ──
# Lake root: where the Parquet (bronze/ gold/) lives. Default: platform user-data dir.
# AURALAKE_HOME=~/.local/share/auralake
# AURALAKE_BASE_CURRENCY=USD              # ingest asserts all rows match this
# AURALAKE_CONNECTIONS_PATH=              # default: <home>/config/connections.yml

# Parquet write codec (BRONZE partitions + GOLD files).
# AURALAKE_PARQUET_COMPRESSION=zstd
# AURALAKE_PARQUET_COMPRESSION_LEVEL=3    # zstd 1–22

# MCP server (auralake mcp serve).
# AURALAKE_MCP_HOST=0.0.0.0
# AURALAKE_MCP_PORT=8002

# Dashboard (auralake dashboard serve).
# AURALAKE_DASHBOARD_HOST=127.0.0.1
# AURALAKE_DASHBOARD_PORT=8501
