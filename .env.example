# ── Postgres (required) ────────────────────────────────────
POSTGRES_USER=auralake
POSTGRES_PASSWORD=changeme
POSTGRES_DB=auralake

# ── Encryption key (required — generate BEFORE first run) ──
# The server will refuse to start if this is empty.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AURALAKE_ENCRYPTION_KEY=

# ── Quick-start guide ──────────────────────────────────────
# 1. Copy this file to .env and fill in AURALAKE_ENCRYPTION_KEY above.
# 2. Run: docker compose up -d
# 3. Grab the auto-generated API key from the logs:
#      docker compose logs backend | grep auto_bootstrap
# 4. Or use the interactive setup wizard:
#      auralake auth setup --server http://localhost:8000
#
# All other config (Databricks, AWS, GitHub) is stored encrypted in the DB.
# Use the /api/v1/connections API or `auralake auth setup` to configure.
