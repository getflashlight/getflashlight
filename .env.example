# Flashlight runs as a single pip-installed binary — no database, no Docker.
# Everything here is optional; copy to .env only if you need to override a default.
#
#   pip install getflashlight
#   flashlight sample            # download the FOCUS sample + seed it (no config)
#   flashlight dashboard serve   # http://127.0.0.1:8501

# ── Source credentials (referenced by connections.yml *_env fields) ──
# Only needed once you enable the matching connector in connections.yml.
DATABRICKS_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only if redshift's db_password_env names this var (direct connection or over an
# SSH tunnel, same field either way) — a plain native DB user password (not IAM).
# The name here is just an example; it must match whatever you put in connections.yml.
# REDSHIFT_DB_PASSWORD=

# ── Platform settings (FLASHLIGHT_*, all optional — defaults shown) ──
# Lake root: where the Parquet (bronze/ gold/) lives. Default: platform user-data dir.
# FLASHLIGHT_HOME=~/.local/share/flashlight
# FLASHLIGHT_BASE_CURRENCY=USD              # ingest asserts all rows match this
# FLASHLIGHT_CONNECTIONS_PATH=              # default: <home>/config/connections.yml

# Parquet write codec (BRONZE partitions + GOLD files).
# FLASHLIGHT_PARQUET_COMPRESSION=zstd
# FLASHLIGHT_PARQUET_COMPRESSION_LEVEL=3    # zstd 1–22

# MCP server (flashlight mcp serve).
# FLASHLIGHT_MCP_HOST=0.0.0.0
# FLASHLIGHT_MCP_PORT=8002

# Dashboard (flashlight dashboard serve).
# FLASHLIGHT_DASHBOARD_HOST=127.0.0.1
# FLASHLIGHT_DASHBOARD_PORT=8501
