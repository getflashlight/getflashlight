# ── Postgres (bundled store) ───────────────────────────────
POSTGRES_USER=auralake
POSTGRES_PASSWORD=auralake
POSTGRES_DB=auralake

# ── API / Grafana ──────────────────────────────────────────
# Leave AURALAKE_API_KEY empty for an open local API; set it to require x-api-key.
AURALAKE_API_KEY=
GRAFANA_PASSWORD=admin

# ── Source credentials (referenced by config/connections.yml *_env) ──
DATABRICKS_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Quick start ────────────────────────────────────────────
# 1. cp .env.example .env
# 2. cp config/connections.example.yml config/connections.yml  (edit it)
# 3. docker compose up -d                  # db, migrate, server, mcp, grafana
# 4. docker compose --profile ingest run --rm ingest   # pull billing data
# 5. open http://localhost:3000            # Grafana → Auralake → TCO Overview
#    API:  http://localhost:8001/health    MCP: http://localhost:8002
