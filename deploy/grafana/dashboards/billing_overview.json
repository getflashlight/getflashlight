{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 0,
  "title": "Auralake \u2014 Billing Overview",
  "uid": "auralake-billing-overview",
  "tags": [
    "auralake",
    "focus",
    "billing"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-180d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Current-month bill (net)",
      "description": "Net effective cost for the in-progress month. Partial \u2014 still accruing.",
      "datasource": {
        "type": "postgres",
        "uid": "auralake_pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT sum(net_cost) AS value FROM gold.monthly_bill WHERE is_partial_period",
          "datasource": {
            "type": "postgres",
            "uid": "auralake_pg"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Realized discount (current month)",
      "description": "Savings vs list rates = (list \u2212 effective) / list.",
      "datasource": {
        "type": "postgres",
        "uid": "auralake_pg"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT savings_pct AS value FROM gold.savings_summary_month ORDER BY charge_month DESC LIMIT 1",
          "datasource": {
            "type": "postgres",
            "uid": "auralake_pg"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Monthly bill: list vs effective",
      "description": "What you'd pay at list vs what you actually pay (negotiated).",
      "datasource": {
        "type": "postgres",
        "uid": "auralake_pg"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT charge_month::timestamp AS time, sum(list_cost) AS \"List\", sum(effective_cost) AS \"Effective\" FROM gold.savings_summary_month GROUP BY charge_month ORDER BY charge_month",
          "datasource": {
            "type": "postgres",
            "uid": "auralake_pg"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "piechart",
      "title": "Where it goes \u2014 by service (all time)",
      "datasource": {
        "type": "postgres",
        "uid": "auralake_pg"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": "/^value$/"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT service_name AS metric, sum(net_cost) AS value FROM gold.spend_by_service_month GROUP BY service_name ORDER BY value DESC",
          "datasource": {
            "type": "postgres",
            "uid": "auralake_pg"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Top SKUs by spend (all time)",
      "datasource": {
        "type": "postgres",
        "uid": "auralake_pg"
      },
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "sku_id"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT sku_id, sum(net_cost) AS net_cost FROM gold.spend_by_sku_month GROUP BY sku_id ORDER BY net_cost DESC LIMIT 10",
          "datasource": {
            "type": "postgres",
            "uid": "auralake_pg"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Spend by team tag (all time)",
      "description": "Cost allocation via the 'team' tag. Untagged spend is not shown here.",
      "datasource": {
        "type": "postgres",
        "uid": "auralake_pg"
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT tag_value AS team, sum(net_cost) AS net_cost FROM gold.spend_by_tag_month WHERE tag_key = 'team' GROUP BY tag_value ORDER BY net_cost DESC LIMIT 15",
          "datasource": {
            "type": "postgres",
            "uid": "auralake_pg"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Daily spend trend",
      "datasource": {
        "type": "postgres",
        "uid": "auralake_pg"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT charge_day::timestamp AS time, provider_name AS metric, net_cost AS value FROM gold.spend_trend_daily ORDER BY charge_day",
          "datasource": {
            "type": "postgres",
            "uid": "auralake_pg"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Monthly spend by SKU (last 6 months)",
      "description": "Stacked monthly EffectiveCost per SKU \u2014 the cost trend.",
      "datasource": {
        "type": "postgres",
        "uid": "auralake_pg"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT charge_month::timestamp AS time, sku_id AS metric, sum(net_cost) AS value FROM gold.spend_by_sku_month GROUP BY charge_month, sku_id ORDER BY time",
          "datasource": {
            "type": "postgres",
            "uid": "auralake_pg"
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Monthly DBU usage by SKU (volume side)",
      "description": "Stacked consumed DBUs per SKU \u2014 shows whether cost moves are usage-driven.",
      "datasource": {
        "type": "postgres",
        "uid": "auralake_pg"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT charge_month::timestamp AS time, sku_id AS metric, sum(consumed_quantity) AS value FROM gold.spend_by_sku_month WHERE consumed_unit='DBU' GROUP BY charge_month, sku_id ORDER BY time",
          "datasource": {
            "type": "postgres",
            "uid": "auralake_pg"
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "SKU \u00d7 month \u2014 spend ($)",
      "description": "EffectiveCost per SKU per month. Each month has two columns: the absolute spend ('Jan') and a per-ROW heat indicator ('Jan %') = that month as a % of THIS SKU's own busiest month. The heat % is colored yellow\u2192red, so within each row that SKU's peak month(s) glow red regardless of the SKU's absolute size \u2014 a small SKU's worst month reads just as red as a big SKU's. Dollars stay neutral for reference; 'Total' is absolute lifetime spend. 'Jun' is a partial month. SKU names have the shared 'ENTERPRISE_' prefix stripped. Sorted highest total spend first.",
      "datasource": {
        "type": "postgres",
        "uid": "auralake_pg"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 11
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0,
          "custom": {
            "align": "right",
            "cellOptions": {
              "type": "auto"
            }
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/%$/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "custom.width",
                "value": 70
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-YlRd"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sku_id"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "left"
              },
              {
                "id": "custom.width",
                "value": 380
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": [
            "Jan",
            "Feb",
            "Mar",
            "Apr",
            "May",
            "Jun (partial)",
            "Total"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH m AS (SELECT replace(sku_id,'ENTERPRISE_','') AS sku_id, coalesce(sum(net_cost) FILTER (WHERE charge_month='2026-01-01'),0) AS m1, coalesce(sum(net_cost) FILTER (WHERE charge_month='2026-02-01'),0) AS m2, coalesce(sum(net_cost) FILTER (WHERE charge_month='2026-03-01'),0) AS m3, coalesce(sum(net_cost) FILTER (WHERE charge_month='2026-04-01'),0) AS m4, coalesce(sum(net_cost) FILTER (WHERE charge_month='2026-05-01'),0) AS m5, coalesce(sum(net_cost) FILTER (WHERE charge_month='2026-06-01'),0) AS m6, sum(net_cost) AS total FROM gold.spend_by_sku_month GROUP BY sku_id) SELECT sku_id, round(m1,2) AS \"Jan\", round(100*m1/NULLIF(GREATEST(m1,m2,m3,m4,m5,m6),0)) AS \"Jan %\", round(m2,2) AS \"Feb\", round(100*m2/NULLIF(GREATEST(m1,m2,m3,m4,m5,m6),0)) AS \"Feb %\", round(m3,2) AS \"Mar\", round(100*m3/NULLIF(GREATEST(m1,m2,m3,m4,m5,m6),0)) AS \"Mar %\", round(m4,2) AS \"Apr\", round(100*m4/NULLIF(GREATEST(m1,m2,m3,m4,m5,m6),0)) AS \"Apr %\", round(m5,2) AS \"May\", round(100*m5/NULLIF(GREATEST(m1,m2,m3,m4,m5,m6),0)) AS \"May %\", round(m6,2) AS \"Jun (partial)\", round(100*m6/NULLIF(GREATEST(m1,m2,m3,m4,m5,m6),0)) AS \"Jun %\", round(total,2) AS \"Total\" FROM m ORDER BY \"Total\" DESC",
          "datasource": {
            "type": "postgres",
            "uid": "auralake_pg"
          }
        }
      ]
    }
  ]
}
