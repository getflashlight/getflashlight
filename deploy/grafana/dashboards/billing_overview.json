  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Current-month bill (net)",
      "description": "Net effective cost for the in-progress month. Partial \u2014 still accruing.",
      "datasource": {
        "type": "postgres",
        "uid": "auralake_pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0
