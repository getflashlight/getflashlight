      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT tag_value AS team, sum(net_cost) AS net_cost FROM gold.spend_by_tag_month WHERE tag_key = 'team' GROUP BY tag_value ORDER BY net_cost DESC LIMIT 15",
          "datasource": {
