{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "Auralake — Billing Overview",
  "uid": "auralake-billing-overview",
  "tags": ["auralake", "focus", "billing"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-180d", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Current-month bill (net)",
      "description": "Net effective cost for the in-progress month. Partial — still accruing.",
      "datasource": { "type": "postgres", "uid": "auralake_pg" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT sum(net_cost) AS value FROM gold.monthly_bill WHERE is_partial_period",
          "datasource": { "type": "postgres", "uid": "auralake_pg" }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Realized discount (current month)",
      "description": "Savings vs list rates = (list − effective) / list.",
      "datasource": { "type": "postgres", "uid": "auralake_pg" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT savings_pct AS value FROM gold.savings_summary_month ORDER BY charge_month DESC LIMIT 1",
          "datasource": { "type": "postgres", "uid": "auralake_pg" }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Monthly bill: list vs effective",
      "description": "What you'd pay at list vs what you actually pay (negotiated).",
      "datasource": { "type": "postgres", "uid": "auralake_pg" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "custom": { "drawStyle": "bars", "fillOpacity": 60 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT charge_month::timestamp AS time, sum(list_cost) AS \"List\", sum(effective_cost) AS \"Effective\" FROM gold.savings_summary_month GROUP BY charge_month ORDER BY charge_month",
          "datasource": { "type": "postgres", "uid": "auralake_pg" }
        }
      ]
    },
    {
      "id": 4,
      "type": "piechart",
      "title": "Where it goes — by service (all time)",
      "datasource": { "type": "postgres", "uid": "auralake_pg" },
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "values": ["value"] } },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT service_name AS metric, sum(net_cost) AS value FROM gold.spend_by_service_month GROUP BY service_name ORDER BY value DESC",
          "datasource": { "type": "postgres", "uid": "auralake_pg" }
        }
      ]
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Top SKUs by spend (all time)",
      "datasource": { "type": "postgres", "uid": "auralake_pg" },
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "options": { "orientation": "horizontal", "xField": "sku_id" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT sku_id, sum(net_cost) AS net_cost FROM gold.spend_by_sku_month GROUP BY sku_id ORDER BY net_cost DESC LIMIT 10",
          "datasource": { "type": "postgres", "uid": "auralake_pg" }
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Spend by team tag (all time)",
      "description": "Cost allocation via the 'team' tag. Untagged spend is not shown here.",
      "datasource": { "type": "postgres", "uid": "auralake_pg" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT tag_value AS team, sum(net_cost) AS net_cost FROM gold.spend_by_tag_month WHERE tag_key = 'team' GROUP BY tag_value ORDER BY net_cost DESC LIMIT 15",
          "datasource": { "type": "postgres", "uid": "auralake_pg" }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Daily spend trend",
      "datasource": { "type": "postgres", "uid": "auralake_pg" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT charge_day::timestamp AS time, provider_name AS metric, net_cost AS value FROM gold.spend_trend_daily ORDER BY charge_day",
          "datasource": { "type": "postgres", "uid": "auralake_pg" }
        }
      ]
    }
  ]
}
