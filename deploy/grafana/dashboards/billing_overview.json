      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT charge_month::timestamp AS time, sum(list_cost) AS \"List\", sum(effective_cost) AS \"Effective\" FROM gold.savings_summary_month GROUP BY charge_month ORDER BY charge_month",
          "datasource": {
            "type": "postgres",
            "uid": "auralake_pg"
          }
        }
      ]
    },
