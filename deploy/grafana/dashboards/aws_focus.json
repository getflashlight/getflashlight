{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "Auralake — AWS Spend (FOCUS)",
  "uid": "auralake-aws-focus",
  "tags": ["auralake", "focus", "aws"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-90d", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "AWS cost — current month",
      "description": "Net EffectiveCost for the latest (in-progress) charge month. Partial.",
      "datasource": { "type": "postgres", "uid": "auralake_pg" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT net_cost FROM gold.monthly_bill WHERE provider_name = 'AWS' ORDER BY charge_month DESC LIMIT 1",
          "datasource": { "type": "postgres", "uid": "auralake_pg" }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "AWS cost — all time",
      "description": "Sum of net EffectiveCost across every loaded charge month.",
      "datasource": { "type": "postgres", "uid": "auralake_pg" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT sum(net_cost) FROM gold.monthly_bill WHERE provider_name = 'AWS'",
          "datasource": { "type": "postgres", "uid": "auralake_pg" }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "AWS savings — all time",
      "description": "ListCost − EffectiveCost: discounts, credits, and commitment savings.",
      "datasource": { "type": "postgres", "uid": "auralake_pg" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT sum(savings) FROM gold.monthly_bill WHERE provider_name = 'AWS'",
          "datasource": { "type": "postgres", "uid": "auralake_pg" }
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "AWS services",
      "description": "Distinct FOCUS ServiceName values with AWS spend.",
      "datasource": { "type": "postgres", "uid": "auralake_pg" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(DISTINCT service_name) FROM gold.spend_by_service_month WHERE provider_name = 'AWS'",
          "datasource": { "type": "postgres", "uid": "auralake_pg" }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Daily AWS spend",
      "description": "Net EffectiveCost per charge day (charge-period grain).",
      "datasource": { "type": "postgres", "uid": "auralake_pg" },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "custom": { "drawStyle": "bars", "fillOpacity": 40 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT charge_day AS time, 'AWS net cost' AS metric, net_cost AS value FROM gold.spend_trend_daily WHERE provider_name = 'AWS' AND $__timeFilter(charge_day) ORDER BY charge_day",
          "datasource": { "type": "postgres", "uid": "auralake_pg" }
        }
      ]
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "AWS spend by service category (all time)",
      "datasource": { "type": "postgres", "uid": "auralake_pg" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "values": ["value"] } },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT service_category AS metric, sum(net_cost) AS value FROM gold.spend_by_service_month WHERE provider_name = 'AWS' GROUP BY service_category ORDER BY value DESC",
          "datasource": { "type": "postgres", "uid": "auralake_pg" }
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Top AWS services (latest month)",
      "datasource": { "type": "postgres", "uid": "auralake_pg" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [
        { "matcher": { "id": "byRegexp", "options": ".*cost.*" }, "properties": [ { "id": "unit", "value": "currencyUSD" } ] }
      ] },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT service_name, service_category, sum(net_cost) AS net_cost FROM gold.spend_by_service_month WHERE provider_name = 'AWS' AND charge_month = (SELECT max(charge_month) FROM gold.spend_by_service_month WHERE provider_name = 'AWS') GROUP BY service_name, service_category ORDER BY net_cost DESC LIMIT 20",
          "datasource": { "type": "postgres", "uid": "auralake_pg" }
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Top AWS SKUs (latest month)",
      "description": "By SKU with consumed quantity/unit.",
      "datasource": { "type": "postgres", "uid": "auralake_pg" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [
        { "matcher": { "id": "byRegexp", "options": ".*cost.*" }, "properties": [ { "id": "unit", "value": "currencyUSD" } ] }
      ] },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT service_name, sku_id, sum(net_cost) AS net_cost, sum(consumed_quantity) AS quantity, max(consumed_unit) AS unit FROM gold.spend_by_sku_month WHERE provider_name = 'AWS' AND charge_month = (SELECT max(charge_month) FROM gold.spend_by_sku_month WHERE provider_name = 'AWS') GROUP BY service_name, sku_id ORDER BY net_cost DESC LIMIT 20",
          "datasource": { "type": "postgres", "uid": "auralake_pg" }
        }
      ]
    },
    {
      "id": 9,
      "type": "barchart",
      "title": "Monthly AWS bill (net)",
      "datasource": { "type": "postgres", "uid": "auralake_pg" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "options": { "orientation": "auto", "showValue": "auto", "legend": { "showLegend": false } },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT to_char(charge_month, 'YYYY-MM') AS month, net_cost FROM gold.monthly_bill WHERE provider_name = 'AWS' ORDER BY charge_month",
          "datasource": { "type": "postgres", "uid": "auralake_pg" }
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "AWS spend by tag (latest month)",
      "description": "Allocation by FOCUS Tags — one row per (tag_key, tag_value).",
      "datasource": { "type": "postgres", "uid": "auralake_pg" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [
        { "matcher": { "id": "byRegexp", "options": ".*cost.*" }, "properties": [ { "id": "unit", "value": "currencyUSD" } ] }
      ] },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT tag_key, tag_value, sum(net_cost) AS net_cost FROM gold.spend_by_tag_month WHERE provider_name = 'AWS' AND charge_month = (SELECT max(charge_month) FROM gold.spend_by_tag_month WHERE provider_name = 'AWS') GROUP BY tag_key, tag_value ORDER BY net_cost DESC LIMIT 20",
          "datasource": { "type": "postgres", "uid": "auralake_pg" }
        }
      ]
    }
  ]
}
