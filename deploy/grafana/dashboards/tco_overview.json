{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "Auralake — TCO Overview",
  "uid": "auralake-tco-overview",
  "tags": ["auralake", "focus", "tco"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-90d", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Current-month total cost (TCO)",
      "description": "DBU + attributed infra + unattributed AWS for the in-progress month. Partial.",
      "datasource": { "type": "postgres", "uid": "auralake_pg" },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT total_cost FROM gold.tco_summary_month WHERE is_partial_period ORDER BY charge_month DESC LIMIT 1",
          "datasource": { "type": "postgres", "uid": "auralake_pg" }
        }
      ]
    },
    {
      "id": 2,
      "type": "piechart",
      "title": "Spend by service category (all time)",
      "datasource": { "type": "postgres", "uid": "auralake_pg" },
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "values": ["value"] } },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT service_category AS metric, sum(net_cost) AS value FROM gold.spend_by_service_month GROUP BY service_category ORDER BY value DESC",
          "datasource": { "type": "postgres", "uid": "auralake_pg" }
        }
      ]
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Monthly TCO breakdown",
      "description": "DBU vs attributed infra vs unattributed AWS, per month.",
      "datasource": { "type": "postgres", "uid": "auralake_pg" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "gradient" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT to_char(charge_month,'YYYY-MM') AS month, dbu_cost AS \"DBU\", attributed_infra_cost AS \"Attributed infra\", unattributed_infra_cost AS \"Unattributed AWS\" FROM gold.tco_summary_month ORDER BY charge_month DESC LIMIT 6",
          "datasource": { "type": "postgres", "uid": "auralake_pg" }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Daily spend trend by provider",
      "datasource": { "type": "postgres", "uid": "auralake_pg" },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT charge_day AS time, provider_name AS metric, net_cost AS value FROM gold.spend_trend_daily WHERE $__timeFilter(charge_day) ORDER BY charge_day",
          "datasource": { "type": "postgres", "uid": "auralake_pg" }
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Unattributed AWS (current month)",
      "description": "AWS spend not tied to a Databricks cluster — surfaced honestly, not hidden.",
      "datasource": { "type": "postgres", "uid": "auralake_pg" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT unattributed_infra_cost FROM gold.tco_summary_month WHERE is_partial_period ORDER BY charge_month DESC LIMIT 1",
          "datasource": { "type": "postgres", "uid": "auralake_pg" }
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "TCO by Databricks cluster (latest month)",
      "datasource": { "type": "postgres", "uid": "auralake_pg" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 18 },
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [
        { "matcher": { "id": "byRegexp", "options": ".*cost.*" }, "properties": [ { "id": "unit", "value": "currencyUSD" } ] }
      ] },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT cluster_id, compute_class, tco_basis, dbu_cost, infra_cost, tco_cost, infra_pct_of_tco FROM gold.tco_by_cluster_month WHERE charge_month = (SELECT max(charge_month) FROM gold.tco_by_cluster_month) ORDER BY tco_cost DESC",
          "datasource": { "type": "postgres", "uid": "auralake_pg" }
        }
      ]
    }
  ]
}
