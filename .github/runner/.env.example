GITHUB_URL=https://github.com/ychaparala/flashlight

# Provide ONE of the following:
# Fine-grained PAT with repo Administration: read/write (mints tokens automatically).
GITHUB_PAT=
# ...or a short-lived registration token from repo Settings → Actions → Runners.
RUNNER_TOKEN=

RUNNER_NAME=flashlight-docker
RUNNER_LABELS=self-hosted,docker,linux,x64
RUNNER_EPHEMERAL=false
